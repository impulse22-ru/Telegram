# App
APP_ENV=dev
HTTP_PORT=8080

# Postgres (совпадает с docker-compose)
PG_DSN=postgres://tg:tg@localhost:5432/tiktok?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m

# Telegram (локальный Bot API сервер)
# Получить: my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=

# Локальный Bot API: не заполняйте — сервер ходит в Telegram напрямую
BOT_API_BASE=http://localhost:8081

# Закрытый канал ленты (tg_chat_id, отрицательное число вида -100...)
# Заполняется после создания канала и назначения бота админом.
FEED_CHAT_ID=0

# Медиа-релей
RELAY_PORT=8082
RELAY_CACHE_DIR=./media_cache